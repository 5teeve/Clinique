<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Clinique</display-name>

    <context-param>
        <param-name>base-packages</param-name>
        <param-value>com.projet.controller</param-value>
    </context-param>

    <context-param>
        <param-name>view.prefix</param-name>
        <param-value>/WEB-INF/views/</param-value>
    </context-param>
    <context-param>
        <param-name>view.suffix</param-name>
        <param-value>.jsp</param-value>
    </context-param>

    <!--
        Spring est initialise avant le framework afin que le controleur puisse
        obtenir son repository des son instanciation.
    -->
    <listener>
        <listener-class>com.projet.listener.AppLifecycleListener</listener-class>
    </listener>
    <listener>
        <listener-class>mg.itu.framework.listener.FrameworkInitializerListener</listener-class>
    </listener>

    <servlet>
        <servlet-name>FrontServlet</servlet-name>
        <servlet-class>com.projet.servlet.FrontServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <!-- Prefixe /app : les forwards vers les JSP ne repassent pas par le servlet. -->
    <servlet-mapping>
        <servlet-name>FrontServlet</servlet-name>
        <url-pattern>/app/*</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

</web-app>
