<%
    String ctx = request.getContextPath();
%>
<style>
    :root {
        --vert: #0f766e;
        --vert-fonce: #115e59;
        --vert-clair: #ccfbf1;
        --gris: #475569;
        --fond: #f8fafc;
        --danger: #b91c1c;
    }

    * { box-sizing: border-box; }

    body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        color: #0f172a;
        background: var(--fond);
        line-height: 1.5;
    }

    header {
        background: var(--vert);
        color: #fff;
        padding: 1rem 1.5rem;
    }

    header .marque {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        max-width: 960px;
        margin: 0 auto;
        flex-wrap: wrap;
    }

    header strong { font-size: 1.25rem; }

    nav a {
        color: #ecfeff;
        text-decoration: none;
        margin-left: 1rem;
        font-weight: 500;
    }

    nav a:hover { text-decoration: underline; }

    main {
        max-width: 960px;
        margin: 0 auto;
        padding: 1.5rem;
    }

    h1, h2 { color: var(--vert-fonce); }

    .carte {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 1.25rem;
        box-shadow: 0 1px 2px rgb(15 23 42 / 0.05);
    }

    .alerte {
        padding: .8rem 1rem;
        border-radius: 8px;
        margin-bottom: 1rem;
    }

    .alerte-succes { background: #dcfce7; color: #166534; }
    .alerte-erreur { background: #fee2e2; color: #991b1b; }

    table { width: 100%; border-collapse: collapse; background: #fff; }
    th, td { text-align: left; padding: .7rem .6rem; border-bottom: 1px solid #e2e8f0; }
    th { background: var(--vert-clair); color: var(--vert-fonce); font-size: .9rem; }
    tr:hover td { background: #f0fdfa; }

    .actions { display: flex; gap: .4rem; align-items: center; flex-wrap: wrap; }
    .actions form { margin: 0; }

    .btn, button {
        display: inline-block;
        border: 0;
        border-radius: 8px;
        padding: .5rem .9rem;
        font-size: .9rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        background: var(--vert);
        color: #fff;
    }

    .btn:hover, button:hover { background: var(--vert-fonce); }
    .btn-secondaire { background: #e2e8f0; color: #0f172a; }
    .btn-secondaire:hover { background: #cbd5e1; }
    .btn-danger, button.danger { background: var(--danger); }
    .btn-danger:hover, button.danger:hover { background: #7f1d1d; }

    form.champ { margin: 0; }
    form .ligne { margin-bottom: 1rem; }
    label { display: block; font-weight: 600; margin-bottom: .25rem; }
    input[type="text"], input[type="tel"] {
        width: 100%;
        max-width: 420px;
        padding: .55rem .7rem;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font: inherit;
    }
    input:focus { outline: 2px solid var(--vert-clair); border-color: var(--vert); }

    .vide { color: var(--gris); font-style: italic; }
    .meta { color: var(--gris); font-size: .9rem; }
</style>
<header>
    <div class="marque">
        <strong>Clinique</strong>
        <nav>
            <a href="<%= ctx %>/app/">Accueil</a>
            <a href="<%= ctx %>/app/patients">Patients</a>
            <a href="<%= ctx %>/app/patients/new">Nouveau patient</a>
            <a href="<%= ctx %>/app/api/patients">API JSON</a>
        </nav>
    </div>
</header>
